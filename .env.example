# Puerto de ejecución
PORT=3000

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME="WAPPY ARL - Plataforma de Intermediación & CRM"

# Inteligencia Artificial Google Gemini (Opcional para respuestas en tiempo real)
GEMINI_API_KEY=""

# Base de Datos PostgreSQL 16 (Opcional - Si se omite, el sistema usa persistencia automática en disco en data/praxis_db_store.json)
# Ejemplo local/Dokploy: postgresql://wappy_admin:WappySecure2026!@postgres:5432/wappy_arl_db
# Ejemplo Supabase/Neon: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=""

# Directorio de almacenamiento de datos persistentes en servidor (Por defecto: ./data)
DATA_DIR=""
